# ============================================================
# Document Q&A Bot - Environment Variables
# ============================================================

# Choose your provider (gemini, groq, openai)
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# ============================================================
# FREE API OPTIONS (Choose ONE)
# ============================================================

# Option 1: Google Gemini (RECOMMENDED - 100% FREE)
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Option 2: Groq (FREE - Fast inference)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Option 3: OpenAI (PAID - $5 credit)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ============================================================
# OPTIONAL SETTINGS
# ============================================================

# For Gemini (default)
# GEMINI_MODEL=gemini-1.5-flash

# For Groq
# GROQ_MODEL=llama-3.3-70b-versatile

# For OpenAI
# OPENAI_MODEL=gpt-3.5-turbo
